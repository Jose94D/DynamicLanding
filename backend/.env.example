# Copia este archivo como backend/.env y completa los valores. backend/.env no se sube a git.

# Conexión a MySQL/MariaDB (driver PyMySQL)
DATABASE_URL=mysql+pymysql://usuario:clave@127.0.0.1:3306/dynamiclanding?charset=utf8mb4

# Firma la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = la cookie de sesión solo viaja por HTTPS (actívalo en producción)
COOKIE_SECURE=0

# Usuario admin que crea `python -m app.seed` si no existe ninguno.
# Sin ADMIN_PASSWORD se genera una contraseña aleatoria y se muestra una sola vez en consola.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
