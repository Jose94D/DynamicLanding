{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Sistema (landing + panel en :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "MariaDB",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Backend (abre el panel con recarga en :5173)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "MariaDB",
      "serverReadyAction": {
        "pattern": "Uvicorn running on",
        "uriFormat": "http://localhost:5173/admin/",
        "action": "openExternally"
      }
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false,
      "preLaunchTask": "MariaDB"
    }
  ],
  "compounds": [
    {
      "name": "▶ Desarrollo completo (backend + panel con recarga + CSS)",
      "configurations": ["Backend (abre el panel con recarga en :5173)"],
      "preLaunchTask": "Desarrollo: MariaDB + panel + CSS",
      "stopAll": true
    }
  ]
}
